# Path to your .ionapi credentials file downloaded from ION API Gateway
# See README.md for setup instructions
IONAPI_PATH=config/.ionapi

# ION API tenant ID (required — unique per environment, used in API URL path)
INFOR_ION_TENANT_ID=YOUR_TENANT_ID

# Infor LN company number (used in SOAP Activation header)
INFOR_LN_COMPANY=100

# Optional: language code for LN responses (e.g. en, fr)
# INFOR_LN_LANGUAGE=
